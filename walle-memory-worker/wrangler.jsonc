{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walle-memory",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "walle-memory",
      // Local development needs no account. Replace before remote migration/deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
